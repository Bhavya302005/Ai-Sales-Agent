{
  "name": "@sales-agent/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor Android and iOS shells for the SignalPath web app.",
  "scripts": {
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "assets": "node assets/generate-sources.cjs && capacitor-assets generate --android --ios --iconBackgroundColor #07100d --iconBackgroundColorDark #07100d --splashBackgroundColor #07100d --splashBackgroundColorDark #07100d"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "5.9.2"
  }
}
