# Runtime
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_BASE_URL=http://localhost:8001
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8001
DATABASE_URL=postgresql+psycopg://sales_agent:sales_agent@postgres:5432/sales_agent
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# Authentication (development values must still be replaced outside local use)
JWT_ISSUER=ai-sales-agent-local
JWT_AUDIENCE=ai-sales-agent-web
JWT_SECRET=replace-with-at-least-32-random-characters

# Provider credentials (optional in fallback modes)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional resilience key from a legitimate separate Google project.
GEMINI_FALLBACK_API_KEY=
GEMINI_DIALOGUE_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_DIALOGUE_MODEL=claude-haiku-4-5-20251001
SARVAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# One consenting E.164 test number only; do not commit a real value.
TWILIO_TEST_TO_NUMBER=
# Public HTTPS origin of the voice service; Twilio derives WSS from this URL.
PUBLIC_VOICE_BASE_URL=
TWILIO_CONVERSATION_LANGUAGE=en-IN
TAVILY_API_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_VERSION=2026-03
HUBSPOT_WEBHOOK_SECRET=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_WEBHOOK_SECRET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Safe defaults
DISCOVERY_MODE=fixture
EXA_DISCOVERY_MODE=disabled
EXA_DISCOVERY_TIMEOUT_SECONDS=25
SOURCE_ALLOWED_HOSTS=
SOURCE_MAX_BYTES=1000000
VOICE_TRANSPORT=browser
DIALOGUE_MODE=deterministic
DIALOGUE_TIMEOUT_SECONDS=4
CRM_MODE=mock
ASYNC_MODE=inline
RECORD_AUDIO=false
ENABLE_OUTBOUND_PSTN=false
MAX_CALL_SECONDS=300
CALL_WINDOW_START_HOUR=8
CALL_WINDOW_END_HOUR=21
MAX_CONCURRENT_CALLS=1
ESTIMATED_BROWSER_CALL_COST_INR=5
ESTIMATED_PSTN_CALL_COST_INR=15
DAILY_SPEND_LIMIT_INR=500
TRANSCRIPT_RETENTION_DAYS=30
CALLS_KILL_SWITCH=false
